# =============================================================================
# FRESHLOG - TEMPLATE KONFIGURASI ENVIRONMENT VARIABLES (.env.example)
# =============================================================================
# Petunjuk Penggunaan:
# 1. Salin (copy) file ini menjadi file `.env`:
#      cp .env.example .env (Linux/macOS) atau copy .env.example .env (Windows)
# 2. Isi nilai variabel di bawah dengan kredensial asli Anda.
# 3. JANGAN PERNAH meng-commit file `.env` asli ke repositori Git.
# =============================================================================

# Kunci API Google Gemini (untuk analisis cerdas dan preskripsi mitigasi kedaluwarsa)
GEMINI_API_KEY=your_gemini_api_key_here

# Token Bot Telegram (untuk broadcast notifikasi alert stok kritis dan kedaluwarsa)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# (Opsional) Port dan Host Backend FastAPI
PORT=8000
HOST=127.0.0.1

